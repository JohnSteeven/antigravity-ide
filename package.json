{
  "name": "article167",
  "version": "1.0.0",
  "description": "article",
  "scripts": {
    "start": "concurrently -k -n \"server,client\" -c \"blue,magenta\" \"node server/index.js\" \"parcel index.html --port 1234 --no-cache\"",
    "dev": "concurrently -k -n \"server,client\" -c \"blue,magenta\" \"node server/index.js\" \"parcel index.html --port 1234 --no-cache\"",
    "client": "parcel index.html --port 1234 --no-cache",
    "server": "node server/index.js",
    "dev:server": "node server/index.js",
    "build": "parcel build index.html --no-cache",
    "seed:articles": "node server/scripts/seedArticles.js",
    "check:server": "node -e \"const fs=require('fs'),path=require('path'),cp=require('child_process');function walk(d){fs.readdirSync(d).forEach(f=>{const p=path.join(d,f);if(fs.statSync(p).isDirectory())walk(p);else if(p.endsWith('.js'))cp.execSync('node --check \\\"'+p+'\\\"');});}walk('server');console.log('Server JS syntax check passed.');\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:multiplayer": "jest server/tests/multiplayer --runInBand",
    "test:multiplayer:load": "node server/scripts/multiplayerLoad.js",
    "test:life-auction:load": "node server/scripts/lifeAuctionLoad.js",
    "test:life": "jest --runInBand --testPathPattern=server/tests/life",
    "test:premium": "jest --runInBand --testPathPattern=server/tests/premium",
    "test:creator": "jest --runInBand --testPathPattern=server/tests/creator",
    "test:learn": "jest --runInBand --testPathPattern=server/tests/learn",
    "test:life:load": "node server/scripts/lifeOsLoad.js",
    "fixture:life": "node server/scripts/generateLifeFixtures.js",
    "migrate": "node server/scripts/runMigrations.js",
    "migrate:validate": "node server/scripts/runMigrations.js validate",
    "preview:qa": "node server/scripts/serveQaBuild.js",
    "test:multiplayer:preview": "node server/scripts/multiplayerPreviewSmoke.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohnSteeven/STEEVENWRITES.git"
  },
  "keywords": [
    "LIFE",
    "INCIDENTS",
    "ABOUTME"
  ],
  "author": "NOBLE JOHN STEEVEN",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/JohnSteeven/STEEVENWRITES/issues"
  },
  "homepage": "https://github.com/JohnSteeven/STEEVENWRITES#readme",
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/server/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "server/config/seeder.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 90,
        "lines": 90
      }
    }
  },
  "devDependencies": {
    "@parcel/packager-raw-url": "^2.16.4",
    "@parcel/transformer-webmanifest": "^2.16.4",
    "concurrently": "^10.0.4",
    "http-proxy-middleware": "^4.2.0",
    "jest": "^29.7.0",
    "parcel": "^2.16.4",
    "supertest": "^7.2.2"
  },
  "browserslist": [
    "last 1 Chrome version",
    "last 1 Safari version",
    "last 1 Firefox version",
    "last 1 Edge version"
  ],
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "framer-motion": "^12.42.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.6.0",
    "react-router-dom": "^6.30.1",
    "redis": "^5.12.1",
    "sanitize-html": "^2.14.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "speakeasy": "^2.0.0",
    "twilio": "^5.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  }
}
