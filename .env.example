NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:1234
PARCEL_AUTH_API_URL=http://localhost:5000
PARCEL_MULTIPLAYER_ENABLED=true
PARCEL_LIFE_AUCTION_ENABLED=true
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/myjourney
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
CSRF_ENABLED=false # Set to true in staging/production

# ── Play With Friends ─────────────────────────────────────────────────────────
MULTIPLAYER_ENABLED=true
LIFE_AUCTION_ENABLED=true
LIFE_AUCTION_SEALED_ENABLED=true
LIFE_AUCTION_EVENTS_ENABLED=true
LIFE_AUCTION_GROUP_EVENTS_ENABLED=true
MULTIPLAYER_GUEST_SECRET=replace-with-a-separate-long-random-secret
MULTIPLAYER_ANALYTICS_SALT=replace-with-a-separate-random-salt
MULTIPLAYER_ROOM_TTL_HOURS=6
MULTIPLAYER_HOST_GRACE_SECONDS=45
MULTIPLAYER_ANALYTICS_RETENTION_DAYS=90
# Redis is mandatory for horizontally scaled production realtime nodes.
REDIS_URL=redis://127.0.0.1:6379
MULTIPLAYER_REQUIRE_REDIS=false

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello@example.com
SMTP_PASS=replace-me
MAIL_FROM="MyJourney <hello@example.com>"

SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=replace-me
TWILIO_AUTH_TOKEN=replace-me
TWILIO_FROM_NUMBER=+10000000000

# ── Administrator Bootstrap (disabled by default) ─────────────────────────────
# Set BOOTSTRAP_ADMIN_ENABLED=true ONLY on a brand-new installation with no
# existing administrator account. Set it back to false after first login.
# Leaving it false (or unset) is always safe — the seeder will skip this block.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Password must be at least 12 characters. Never use a shared or default value.
